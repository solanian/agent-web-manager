# Frontend-server speech proxy configuration for local Docker speech services.
AWM_SPEECH_ASR_BASE_URL=http://127.0.0.1:19090
AWM_SPEECH_TTS_BASE_URL=http://127.0.0.1:18880
AWM_SPEECH_ASR_MODEL=whisper-1
AWM_SPEECH_TTS_MODEL=supertonic-2
AWM_SPEECH_TTS_VOICE=F1
AWM_SPEECH_TTS_FORMAT=wav

# Docker compose host ports. Change only if these ports are occupied.
AWM_SPEECH_ASR_PORT=19090
AWM_SPEECH_TTS_PORT=18880

# ASR container runtime defaults.
AWM_SPEECH_WHISPER_MODEL=base
AWM_SPEECH_WHISPER_LANGUAGE=ko
AWM_SPEECH_WHISPER_DEVICE=cpu
AWM_SPEECH_WHISPER_COMPUTE_TYPE=int8
AWM_SPEECH_WHISPER_THREADS=2

# Local Supertonic TTS container runtime defaults.
# First run downloads the Supertonic model into Docker volume awm-supertonic-models.
AWM_SPEECH_SUPERTONIC_MODEL=supertonic-2
AWM_SPEECH_SUPERTONIC_LANGUAGE=ko
AWM_SPEECH_SUPERTONIC_VOICE=F1
AWM_SPEECH_SUPERTONIC_TOTAL_STEPS=5
AWM_SPEECH_SUPERTONIC_SPEED=1.05
